# Copie para application-local.yml (gitignored) e preencha com as credenciais
# do seu Jira sandbox. Reinicie o backend após salvar.
#
# Gere o API token em:
#   https://id.atlassian.com/manage-profile/security/api-tokens

jira:
  url: https://SEU-SANDBOX.atlassian.net
  email: voce@empresa.com
  token: "COLE_O_API_TOKEN_AQUI"

